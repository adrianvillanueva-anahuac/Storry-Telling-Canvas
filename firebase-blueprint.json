{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile with assigned workspace role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Editor", "Viewer"] },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator registry document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "grantedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Project": {
      "title": "Project",
      "description": "Storyboard workflow project workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "participants": {
          "type": "object",
          "description": "Email-keyed map of project participant assignments and per-project roles"
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "ownerId", "status"]
    },
    "ImageResource": {
      "title": "ImageResource",
      "description": "Web-based image registry holding Firebase Storage URLs and metadata without raw base64 data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string", "maxLength": 256 },
        "url": { "type": "string", "maxLength": 2048 },
        "storagePath": { "type": "string", "maxLength": 512 },
        "folder": { "type": "string", "enum": ["images", "maps", "objects"] },
        "sizeBytes": { "type": "number" },
        "uploadedBy": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "name", "url", "folder"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Pre-authorized collaborator email and role claim",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Admin", "Editor", "Viewer"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "WorkflowNode": {
      "title": "WorkflowNode",
      "description": "Interactive workflow scene node with URL references and annotations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "x": { "type": "string" },
        "y": { "type": "string" },
        "image": { "type": "string" },
        "imageDeletedFromAdmin": { "type": "boolean" },
        "mapImage": { "type": "string" },
        "mapImageDeletedFromAdmin": { "type": "boolean" },
        "mapName": { "type": "string" },
        "enfoque": { "type": "string" },
        "accion": { "type": "string" },
        "descripcion": { "type": "string" },
        "pinCounter": { "type": "number" },
        "containerId": { "type": "string" },
        "actors": {
          "type": "array",
          "description": "Assigned scene actors/3D elements and their scene states"
        }
      },
      "required": ["id", "projectId", "title", "x", "y"]
    },
    "Connection": {
      "title": "Connection",
      "description": "Directional SVG line linking scene nodes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "source": { "type": "string" },
        "sourcePort": { "type": "string", "enum": ["top", "bottom", "left", "right"] },
        "target": { "type": "string" },
        "targetPort": { "type": "string", "enum": ["top", "bottom", "left", "right"] },
        "type": { "type": "string", "enum": ["curve", "angle", "straight"] },
        "style": { "type": "string", "enum": ["solid", "dotted", "dashed", "parallel"] },
        "color": { "type": "string" },
        "label": { "type": "string", "maxLength": 100 },
        "arrows": { "type": "string", "enum": ["none", "start", "end", "both"] },
        "angleOffset": { "type": "number" },
        "cornerRadius": { "type": "number" },
        "curveOffset": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      },
      "required": ["id", "projectId", "source", "sourcePort", "target", "targetPort"]
    },
    "TextElement": {
      "title": "TextElement",
      "description": "Text labels, sticky notes, and container boxes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "text": { "type": "string" },
        "x": { "type": "string" },
        "y": { "type": "string" },
        "mode": { "type": "string", "enum": ["floating", "annotation", "container"] },
        "color": { "type": "string" },
        "size": { "type": "number" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "labelId": { "type": "string" },
        "body": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "containerId": { "type": "string" }
      },
      "required": ["id", "projectId", "text", "x", "y", "mode"]
    },
    "GlobalVideo": {
      "title": "GlobalVideo",
      "description": "YouTube video reference with metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "author": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "UserGeminiConfig": {
      "title": "UserGeminiConfig",
      "description": "Private per-user Gemini API key configuration isolated to the owning user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "apiKey": { "type": "string", "minLength": 10, "maxLength": 256 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "apiKey", "updatedAt"]
    },
    "ActorItem": {
      "title": "ActorItem",
      "description": "Configurable 3D actor or scene element with thumbnail, possible states, and reusable project tags",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 2000 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "thumbnailPath": { "type": "string", "maxLength": 512 },
        "states": {
          "type": "array",
          "description": "Configurable scene states defined for this actor"
        },
        "tags": {
          "type": "array",
          "description": "Reusable tags for global project reporting and filtering"
        },
        "author": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "projectId", "name", "states", "tags"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/users/{userId}/private/{configId}": {
      "schema": { "$ref": "#/entities/UserGeminiConfig" },
      "description": "Private user settings such as personal Gemini API key"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Workspace administrator records"
    },
    "/invites/{inviteEmail}": {
      "schema": { "$ref": "#/entities/Invite" },
      "description": "Pending collaborator invitations and pre-assigned roles"
    },
    "/images/{imageId}": {
      "schema": { "$ref": "#/entities/ImageResource" },
      "description": "Image registry without raw base64 data"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Workflow projects"
    },
    "/projects/{projectId}/nodes/{nodeId}": {
      "schema": { "$ref": "#/entities/WorkflowNode" },
      "description": "Scene nodes inside a project"
    },
    "/projects/{projectId}/storedNodes/{nodeId}": {
      "schema": { "$ref": "#/entities/WorkflowNode" },
      "description": "Archived scene nodes inside a project"
    },
    "/projects/{projectId}/connections/{connectionId}": {
      "schema": { "$ref": "#/entities/Connection" },
      "description": "Connections inside a project"
    },
    "/projects/{projectId}/texts/{textId}": {
      "schema": { "$ref": "#/entities/TextElement" },
      "description": "Text elements inside a project"
    },
    "/projects/{projectId}/videos/{videoId}": {
      "schema": { "$ref": "#/entities/GlobalVideo" },
      "description": "YouTube video references scoped to a specific project"
    },
    "/projects/{projectId}/actors/{actorId}": {
      "schema": { "$ref": "#/entities/ActorItem" },
      "description": "Configurable actors and 3D elements scoped to a specific project"
    },
    "/globalVideos/{videoId}": {
      "schema": { "$ref": "#/entities/GlobalVideo" },
      "description": "Shared video references"
    }
  }
}
