rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Identity & Validation Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return isVerified() && authEmailLower() == 'adrian.byakko@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'Viewer';
    }

    function isEditorOrAdmin() {
      return isAdmin() || (isVerified() && userRole() in ['Admin', 'Editor']);
    }

    function projectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function projectParticipantRole(projectId) {
      return (
        'participants' in projectData(projectId) &&
        projectData(projectId).participants is map &&
        authEmailLower() in projectData(projectId).participants
      )
        ? projectData(projectId).participants[authEmailLower()].role
        : null;
    }

    function canReadProjectData(projData) {
      return isAdmin() || (
        isVerified() && (
          projData.ownerId == request.auth.uid ||
          !('participants' in projData) ||
          projData.participants.size() == 0 ||
          (projData.participants is map && authEmailLower() in projData.participants)
        )
      );
    }

    function canReadProject(projectId) {
      return isAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        canReadProjectData(projectData(projectId))
      );
    }

    function canEditProject(projectId) {
      return isAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) && (
          projectParticipantRole(projectId) in ['Admin', 'Editor'] ||
          (projectParticipantRole(projectId) == null && userRole() in ['Admin', 'Editor'])
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasValidInviteRole(targetRole) {
      return exists(/databases/$(database)/documents/invites/$(authEmailLower())) &&
        get(/databases/$(database)/documents/invites/$(authEmailLower())).data.role == targetRole;
    }

    function isValidUser(data) {
      return data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 200 &&
        data.role in ['Admin', 'Editor', 'Viewer'];
    }

    function isValidImage(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 256 &&
        data.url is string &&
        data.url.size() > 0 &&
        data.url.size() <= 2048 &&
        data.folder in ['images', 'maps', 'objects'] &&
        (!('projectId' in data) || isValidId(data.projectId)) &&
        (!('sizeBytes' in data) || (data.sizeBytes is number && data.sizeBytes >= 0));
    }

    function isValidVideo(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 256 &&
        (!('projectId' in data) || isValidId(data.projectId));
    }

    function isValidProject(data, projectId) {
      return data.id == projectId &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 150 &&
        data.ownerId is string &&
        data.ownerId.size() > 0 &&
        data.ownerId.size() <= 128 &&
        data.status in ['active', 'archived'] &&
        (!('participants' in data) || data.participants is map);
    }

    function isValidNode(data, nodeId) {
      return data.id == nodeId &&
        data.title is string &&
        data.title.size() <= 200 &&
        data.x is string &&
        data.x.size() <= 40 &&
        data.y is string &&
        data.y.size() <= 40 &&
        (!('labelId' in data) || data.labelId == null || (data.labelId is string && data.labelId.size() <= 128)) &&
        (!('actors' in data) || (data.actors is list && data.actors.size() <= 100));
    }

    function isValidActor(data, actorId, projectId) {
      return data.id == actorId &&
        data.projectId == projectId &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 150 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 80)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048)) &&
        (!('thumbnailPath' in data) || data.thumbnailPath == null || (data.thumbnailPath is string && data.thumbnailPath.size() <= 512)) &&
        data.states is list &&
        data.states.size() <= 50 &&
        (data.states.size() == 0 || data.states[0] is map) &&
        data.tags is list &&
        data.tags.size() <= 50 &&
        (data.tags.size() == 0 || data.tags[0] is string) &&
        (!('author' in data) || (data.author is string && data.author.size() <= 120)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidConnection(data, connectionId) {
      return data.id == connectionId &&
        data.source is string &&
        data.source.size() > 0 &&
        data.source.size() <= 128 &&
        data.target is string &&
        data.target.size() > 0 &&
        data.target.size() <= 128;
    }

    function isValidText(data, textId) {
      return data.id == textId &&
        data.mode in ['floating', 'annotation', 'container'] &&
        data.text is string &&
        data.text.size() <= 5000 &&
        data.x is string &&
        data.x.size() <= 40 &&
        data.y is string &&
        data.y.size() <= 40 &&
        (!('labelId' in data) || (data.labelId is string && data.labelId.size() <= 128));
    }

    function isValidLabel(data, labelId, projectId) {
      return data.keys().hasAll(['id', 'projectId', 'name', 'color']) &&
        data.keys().hasOnly(['id', 'projectId', 'name', 'color', 'createdAt', 'updatedAt']) &&
        data.id == labelId &&
        data.projectId == projectId &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 60 &&
        data.color is string &&
        data.color.size() >= 4 &&
        data.color.size() <= 20 &&
        data.color.matches('^#[0-9a-fA-F]{3,8}$') &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserGeminiConfig(data, userId) {
      return data.keys().hasAll(['userId', 'apiKey', 'activeKeyId', 'keys', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'apiKey', 'activeKeyId', 'keys', 'updatedAt']) &&
        data.userId is string &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.userId.size() > 0 &&
        data.userId.size() <= 128 &&
        data.apiKey is string &&
        (data.apiKey.size() == 0 || (data.apiKey.size() >= 10 && data.apiKey.size() <= 256)) &&
        (
          data.activeKeyId == null ||
          (
            data.activeKeyId is string &&
            data.activeKeyId.size() > 0 &&
            data.activeKeyId.size() <= 128 &&
            data.activeKeyId.matches('^[a-zA-Z0-9_\\-]+$')
          )
        ) &&
        data.keys is list &&
        data.keys.size() <= 20 &&
        (
          data.keys.size() == 0 ||
          (
            data.keys[0] is map &&
            data.keys[0].keys().hasAll(['id', 'label', 'apiKey', 'createdAt', 'updatedAt']) &&
            data.keys[0].keys().hasOnly(['id', 'label', 'apiKey', 'createdAt', 'updatedAt']) &&
            data.keys[0].id is string &&
            data.keys[0].id.size() > 0 &&
            data.keys[0].id.size() <= 128 &&
            data.keys[0].id.matches('^[a-zA-Z0-9_\\-]+$') &&
            data.keys[0].label is string &&
            data.keys[0].label.size() > 0 &&
            data.keys[0].label.size() <= 60 &&
            data.keys[0].apiKey is string &&
            data.keys[0].apiKey.size() >= 10 &&
            data.keys[0].apiKey.size() <= 256 &&
            data.keys[0].createdAt is string &&
            data.keys[0].createdAt.size() > 0 &&
            data.keys[0].createdAt.size() <= 64 &&
            data.keys[0].updatedAt is string &&
            data.keys[0].updatedAt.size() > 0 &&
            data.keys[0].updatedAt.size() <= 64
          )
        ) &&
        data.updatedAt is string &&
        data.updatedAt.size() > 0 &&
        data.updatedAt.size() <= 64;
    }

    function isValidMediaAsset(data, mediaId, projectId) {
      return data.keys().hasAll(['id', 'projectId', 'mimeType', 'dataUrl', 'sizeBytes', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'projectId', 'mimeType', 'dataUrl', 'sizeBytes', 'createdBy', 'createdAt']) &&
        data.id is string &&
        data.id == mediaId &&
        data.projectId is string &&
        data.projectId == projectId &&
        data.mimeType in ['image/webp', 'image/jpeg', 'image/png'] &&
        data.dataUrl is string &&
        data.dataUrl.size() >= 24 &&
        data.dataUrl.size() <= 900000 &&
        data.dataUrl[0:11] == 'data:image/' &&
        (
          data.dataUrl[11:23] == 'webp;base64,' ||
          data.dataUrl[11:23] == 'jpeg;base64,' ||
          data.dataUrl[11:22] == 'png;base64,'
        ) &&
        data.sizeBytes is number &&
        data.sizeBytes > 0 &&
        data.sizeBytes <= 900000 &&
        data.createdBy is string &&
        data.createdBy == request.auth.uid &&
        data.createdAt is string &&
        data.createdAt.size() > 0 &&
        data.createdAt.size() <= 64;
    }

    // Boot Connectivity Check Collection
    match /test/{docId} {
      allow read: if true;
    }

    // Admins Collection
    match /admins/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && (isAdmin() || (isSuperAdmin() && request.auth.uid == userId));
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Collaborator Invites Collection (prevents user PII scraping)
    match /invites/{inviteEmail} {
      allow get: if isVerified() && (isAdmin() || inviteEmail == authEmailLower());
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        inviteEmail is string &&
        inviteEmail.size() > 3 &&
        inviteEmail.size() <= 200 &&
        incoming().email == inviteEmail &&
        incoming().role in ['Admin', 'Editor', 'Viewer'];
      allow delete: if isAdmin() || (isVerified() && inviteEmail == authEmailLower());
    }

    // Users Collection (PII isolated to owner + Admin)
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (
          isVerified() &&
          request.auth.uid == userId &&
          incoming().email == authEmailLower() &&
          (
            (isSuperAdmin() && incoming().role == 'Admin') ||
            incoming().role == 'Viewer' ||
            hasValidInviteRole(incoming().role)
          )
        )
      );
      allow update: if isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (
          isVerified() &&
          request.auth.uid == userId &&
          incoming().email == existing().email &&
          (
            (isSuperAdmin() && incoming().role == 'Admin') ||
            incoming().role == existing().role ||
            hasValidInviteRole(incoming().role)
          )
        )
      );
      allow delete: if isAdmin() && isValidId(userId);

      // Private per-user API key configuration (strictly owner-only)
      match /private/{configId} {
        allow get: if isVerified() &&
          isValidId(userId) &&
          isValidId(configId) &&
          request.auth.uid == userId;
        allow create: if isVerified() &&
          isValidId(userId) &&
          isValidId(configId) &&
          configId == 'geminiConfig' &&
          request.auth.uid == userId &&
          isValidUserGeminiConfig(incoming(), userId);
        allow update: if isVerified() &&
          isValidId(userId) &&
          isValidId(configId) &&
          configId == 'geminiConfig' &&
          request.auth.uid == userId &&
          isValidUserGeminiConfig(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['apiKey', 'activeKeyId', 'keys', 'updatedAt']);
        allow delete: if isVerified() &&
          isValidId(userId) &&
          isValidId(configId) &&
          configId == 'geminiConfig' &&
          request.auth.uid == userId;
      }
    }

    // Image Web Registry (Vercel Blob / web URLs & metadata, no raw base64)
    match /images/{imageId} {
      allow read: if isVerified();
      allow create, update: if isValidId(imageId) && isValidImage(incoming()) && (
        isEditorOrAdmin() ||
        ('projectId' in incoming() && canEditProject(incoming().projectId))
      );
      allow delete: if isValidId(imageId) && (
        isEditorOrAdmin() ||
        ('projectId' in existing() && canEditProject(existing().projectId))
      );
    }

    // Global Video Library
    match /globalVideos/{videoId} {
      allow read: if isVerified();
      allow create, update: if isEditorOrAdmin() && isValidId(videoId) && isValidVideo(incoming());
      allow delete: if isEditorOrAdmin() && isValidId(videoId);
    }

    // Projects Collection & Nested Canvas Subcollections
    match /projects/{projectId} {
      allow read: if isVerified();
      allow create: if isEditorOrAdmin() &&
        isValidId(projectId) &&
        isValidProject(incoming(), projectId) &&
        incoming().ownerId == request.auth.uid;
      allow update: if isValidId(projectId) &&
        isValidProject(incoming(), projectId) &&
        incoming().ownerId == existing().ownerId && (
          isAdmin() ||
          (
            canEditProject(projectId) &&
            (
              (!('participants' in incoming()) && !('participants' in existing())) ||
              ('participants' in incoming() && 'participants' in existing() && incoming().participants == existing().participants)
            )
          )
        );
      allow delete: if isAdmin() && isValidId(projectId);

      match /nodes/{nodeId} {
        allow read: if canReadProject(projectId);
        allow create, update: if canEditProject(projectId) &&
          isValidId(projectId) &&
          isValidId(nodeId) &&
          isValidNode(incoming(), nodeId);
        allow delete: if canEditProject(projectId) && isValidId(projectId) && isValidId(nodeId);
      }

      match /storedNodes/{nodeId} {
        allow read: if canReadProject(projectId);
        allow create, update: if canEditProject(projectId) &&
          isValidId(projectId) &&
          isValidId(nodeId) &&
          isValidNode(incoming(), nodeId);
        allow delete: if canEditProject(projectId) && isValidId(projectId) && isValidId(nodeId);
      }

      match /connections/{connectionId} {
        allow read: if canReadProject(projectId);
        allow create, update: if canEditProject(projectId) &&
          isValidId(projectId) &&
          isValidId(connectionId) &&
          isValidConnection(incoming(), connectionId);
        allow delete: if canEditProject(projectId) && isValidId(projectId) && isValidId(connectionId);
      }

      match /texts/{textId} {
        allow read: if canReadProject(projectId);
        allow create, update: if canEditProject(projectId) &&
          isValidId(projectId) &&
          isValidId(textId) &&
          isValidText(incoming(), textId);
        allow delete: if canEditProject(projectId) && isValidId(projectId) && isValidId(textId);
      }

      match /videos/{videoId} {
        allow read: if canReadProject(projectId);
        allow create, update: if canEditProject(projectId) &&
          isValidId(projectId) &&
          isValidId(videoId) &&
          isValidVideo(incoming());
        allow delete: if canEditProject(projectId) && isValidId(projectId) && isValidId(videoId);
      }

      match /actors/{actorId} {
        allow read: if canReadProject(projectId);
        allow create, update: if canEditProject(projectId) &&
          isValidId(projectId) &&
          isValidId(actorId) &&
          isValidActor(incoming(), actorId, projectId);
        allow delete: if canEditProject(projectId) && isValidId(projectId) && isValidId(actorId);
      }

      match /labels/{labelId} {
        allow read: if canReadProject(projectId);
        allow create: if canEditProject(projectId) &&
          isValidId(projectId) &&
          isValidId(labelId) &&
          isValidLabel(incoming(), labelId, projectId);
        allow update: if canEditProject(projectId) &&
          isValidId(projectId) &&
          isValidId(labelId) &&
          isValidLabel(incoming(), labelId, projectId) &&
          incoming().id == existing().id &&
          incoming().projectId == existing().projectId;
        allow delete: if canEditProject(projectId) && isValidId(projectId) && isValidId(labelId);
      }

      match /media/{mediaId} {
        allow read: if canReadProject(projectId);
        allow create: if isVerified() &&
          isValidId(projectId) &&
          isValidId(mediaId) &&
          isValidMediaAsset(incoming(), mediaId, projectId) &&
          canEditProject(projectId);
        allow update: if isVerified() &&
          isValidId(projectId) &&
          isValidId(mediaId) &&
          isValidMediaAsset(incoming(), mediaId, projectId) &&
          canEditProject(projectId) &&
          incoming().id == existing().id &&
          incoming().projectId == existing().projectId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['mimeType', 'dataUrl', 'sizeBytes']);
        allow delete: if canEditProject(projectId) && isValidId(projectId) && isValidId(mediaId);
      }
    }
  }
}
