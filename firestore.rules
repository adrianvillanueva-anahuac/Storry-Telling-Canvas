rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'adrian.byakko@gmail.com'
      );
    }

    // Test Collection
    match /test/{docId} {
      allow read: if true;
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Image Web Registry (URLs, metadata, no raw base64)
    match /images/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Global Video Library
    match /globalVideos/{videoId} {
      allow read: if true;
      allow write: if true;
    }

    // Projects Collection & Nested Canvas Subcollections
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;

      match /nodes/{nodeId} {
        allow read: if true;
        allow write: if true;
      }

      match /connections/{connectionId} {
        allow read: if true;
        allow write: if true;
      }

      match /texts/{textId} {
        allow read: if true;
        allow write: if true;
      }

      match /storedNodes/{nodeId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}
