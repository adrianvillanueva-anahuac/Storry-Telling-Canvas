          <button id="deleteAllStoredBtn" class="danger-btn">Delete All</button>
        </div>
        <div id="storedNodesList" style="overflow-y: auto; flex-grow: 1; padding-right: 5px;"></div>
      </div>
    </div>
 
    <button id="lineEditHoverBtn" class="hidden" title="Edit Line Properties">⚙️ Edit Line</button>
    <div id="linePropertiesMenu" class="hidden floating-menu">
      <h4 style="margin: 0; border-bottom: 1px solid var(--node-border); padding-bottom: 5px;">Line Properties</h4>
      <label>Label: <input type="text" id="lineLabelInput" placeholder="Name this line"></label>
      <label>Type: <select id="lineStyleSelect"><option value="solid">Solid</option><option value="dotted">Dotted</option></select></label>
      <label>Arrows: <select id="lineArrowSelect"><option value="none">None</option><option value="end">End Only</option><option value="both">Both Ends</option></select></label>
      <label>Color: <input type="color" id="lineColorInput"></label>
      <button id="deleteLineBtn" class="danger-btn">Remove Connection</button>
    </div>
 
    <div id="textPropertiesMenu" class="hidden floating-menu">
      <h4 style="margin: 0; border-bottom: 1px solid var(--node-border); padding-bottom: 5px;">Text Properties</h4>
      <label>Function: <select id="textModeSelect"><option value="floating">Floating Text</option><option value="annotation">Annotation</option><option value="container">Logic Container</option></select></label>
      <label id="labelSelectorRow" class="hidden">Label: <select id="textLabelSelect"><option value="">None</option></select></label>
      <button id="openLabelManagerBtn" class="icon-btn hidden" style="width: 100%;">Manage Labels</button>
      <label>Color: <input type="color" id="textColorInput"></label>
      <label>Size (px): <input type="number" id="textSizeInput" min="10" max="72" value="16"></label>
      <label>Style: <div><button id="textBoldBtn" class="icon-btn" style="font-weight:bold;">B</button><button id="textItalicBtn" class="icon-btn" style="font-style:italic;">I</button></div></label>
    </div>
 
    <div id="labelManagerModal" class="modal hidden" style="z-index: 3000;">
       <div class="modal-content" style="width: 350px; background: var(--node-bg); padding: 20px; border-radius: 8px; position: relative;">
          <button class="close-btn" id="closeLabelManager" title="Close">×</button>
          <h3 style="margin-top:0;">Manage Color Labels</h3>
          <div style="display:flex; gap:10px; margin-bottom: 15px; align-items: center;">
