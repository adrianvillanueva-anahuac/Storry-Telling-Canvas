                <button id="removeSideMapBtn" class="danger-btn" style="width: 100%; font-size: 11px; margin-top: 5px;">Remove Map</button>
            </div>
        </div>

        <button class="close-btn dashboard-close-btn" id="closeEditModal" title="Close Dashboard">×</button>
        
        <div class="dashboard-top">
