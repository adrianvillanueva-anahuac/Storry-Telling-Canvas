    </div>

    <div id="videoSelectionModal" class="modal hidden" style="z-index: 6500;">
      <div class="modal-content" style="width: 500px; max-height: 70vh; background: var(--node-bg); padding: 20px; border-radius: 8px; display: flex; flex-direction: column; position: relative;">
        <button class="close-btn" id="closeVideoSelectModalBtn" title="Close">×</button>
