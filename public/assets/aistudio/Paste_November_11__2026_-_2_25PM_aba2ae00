  <body>
    <div id="loginModal" class="modal" style="z-index: 99999; background-color: var(--bg-color); display: flex;">
      <div class="modal-content" style="width: 320px; background: var(--node-bg); padding: 30px; border-radius: 8px; text-align: center; border: 1px solid var(--node-border); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <h2 style="margin-top: 0;">Workspace Login</h2>
        <p style="font-size: 13px; color: #888; margin-bottom: 25px;">Please enter your credentials to access the project.</p>
        
        <input type="text" id="loginUsername" placeholder="Username" style="width: 100%; padding: 12px; margin-bottom: 15px; box-sizing: border-box; border-radius: 4px; border: 1px solid var(--grid-color); background: var(--header-bg); color: var(--text-color);">
        <input type="password" id="loginPin" placeholder="PIN" style="width: 100%; padding: 12px; margin-bottom: 25px; box-sizing: border-box; border-radius: 4px; border: 1px solid var(--grid-color); background: var(--header-bg); color: var(--text-color);">
        
        <button id="loginBtn" class="primary-btn" style="width: 100%; padding: 12px; font-size: 16px;">Access Canvas</button>
        <div id="loginError" style="color: #de350b; font-size: 13px; margin-top: 15px; height: 15px; font-weight: bold;"></div>
      </div>
    </div>

    <div id="pinTooltip" class="hidden"></div>
 
    <header class="app-header">
      <div class="header-title"><h1>Visual Workflow Canvas</h1></div>
      <div class="viz-menu">
        <button id="openGalleryBtn" class="icon-btn" style="font-weight: bold; background: var(--btn-hover);">🖼️ Gallery</button>
        <button id="openMapGalleryGlobalBtn" class="icon-btn" style="font-weight: bold; background: var(--btn-hover);">🗺️ Map Lib</button>
        <button id="openGlobalVideosBtn" class="icon-btn" style="font-weight: bold; background: var(--btn-hover);">📹 Video Lib</button>
        <button id="openStoredNodesBtn" class="icon-btn" style="font-weight: bold; background: var(--btn-hover);">📦 Archive (<span id="storedCountBadge">0</span>)</button>
        <button id="addNodeBtn" class="primary-btn">+ Add Node</button>
        
        <div class="dropdown">
          <button class="icon-btn">+ Add Text ▾</button>
          <div class="dropdown-content">
            <button onclick="openTextCreate('floating')">Just Text</button>
            <button onclick="openTextCreate('container')">Container Text</button>
            <button onclick="openTextCreate('annotation')">Note</button>
          </div>
        </div>

        <div class="divider"></div>
        <select id="viewControlSelect" class="icon-btn" style="font-size: 14px;">
          <option id="currentZoomOption" value="custom">100% Zoom</option>
          <option value="100">Reset to 100%</option>
          <option value="center">Center Canvas</option>
          <option value="fit">Fit All Nodes</option>
        </select>
        <button class="icon-btn" id="toggleDarkMode" title="Toggle Dark Mode">☀️</button>
      </div>
    </header>
 
    <div class="canvas-viewport" id="canvasViewport">
      <div class="canvas-container" id="nodeCanvas" style="transform-origin: 0 0; transform: scale(1);">
        <svg id="connectionLayer"><defs id="markerDefs"></defs></svg>
        <svg id="tempLayer"><path id="tempLine" d=""/></svg>
      </div>
    </div>
 
    <div id="addTextModal" class="modal hidden" style="z-index: 4000;">
      <div class="modal-content" style="width: 300px; background: var(--node-bg); padding: 20px; border-radius: 8px;">
        <button class="close-btn" id="closeAddTextModal" title="Close">×</button>
        <h3 style="margin-top:0; border-bottom: 1px solid var(--node-border); padding-bottom: 10px;">Create Text Element</h3>
        <input type="hidden" id="newTextType" value="floating">
        <label style="display:block; margin-bottom: 20px; font-size: 14px; font-weight: bold;"><span id="newTextLabelText">Text:</span>
          <input type="text" id="newTextInput" style="width:100%; padding: 8px; margin-top: 5px; box-sizing: border-box; border-radius: 4px; border: 1px solid var(--grid-color);" placeholder="Enter text...">
        </label>
        <div style="text-align: right;"><button id="confirmAddTextBtn" class="primary-btn">Confirm</button></div>
      </div>
    </div>
 
    <div id="deleteWarningModal" class="modal hidden" style="z-index: 4000;">
      <div class="modal-content" style="width: 350px; background: var(--node-bg); padding: 20px; border-radius: 8px; text-align: center;">
        <button class="close-btn" id="closeDeleteWarnModal" title="Close">×</button>
        <h3 style="margin-top:0; color: #de350b;">Are you Sure? / ¿Seguro?</h3>
        <p style="font-size: 14px; margin-bottom: 20px;">Do you want to permanently delete this node, or store it in the archive for later?</p>
        <div style="display: flex; justify-content: center; gap: 10px;">
          <button id="warnCancelBtn" class="icon-btn">Cancel</button>
          <button id="warnStoreBtn" class="primary-btn" style="background: #0052cc;">Store It</button>
          <button id="warnConfirmBtn" class="danger-btn">Delete</button>
        </div>
      </div>
    </div>
 
    <div id="storedNodesModal" class="modal hidden" style="z-index: 3000;">
      <div class="modal-content" style="width: 500px; max-height: 80vh; background: var(--node-bg); padding: 20px; border-radius: 8px; display: flex; flex-direction: column;">
        <button class="close-btn" id="closeStoredNodes" title="Close">×</button>
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--node-border); padding-bottom: 10px; margin-bottom: 15px;">
