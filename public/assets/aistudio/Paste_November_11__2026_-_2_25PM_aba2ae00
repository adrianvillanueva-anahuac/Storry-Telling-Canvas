            <input type="text" id="newVideoName" placeholder="Video Title" style="flex: 1; padding: 8px; border: 1px solid var(--grid-color); border-radius: 4px;">
            <button id="addGlobalVideoBtn" class="primary-btn">Add Video</button>
        </div>
        <div id="globalVideoList" style="overflow-y: auto; flex-grow: 1; padding-right: 5px;"></div>
