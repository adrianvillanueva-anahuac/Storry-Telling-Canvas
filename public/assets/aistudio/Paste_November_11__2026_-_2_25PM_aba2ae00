             <input type="text" id="newLabelName" placeholder="e.g. Needs Review" style="flex:1; padding: 8px; border: 1px solid var(--grid-color); border-radius: 4px;">
             <button id="addNewLabelBtn" class="primary-btn">Add</button>
          </div>
          <ul id="labelManagerList" style="list-style:none; padding:0; margin:0; max-height:200px; overflow-y:auto; border-top: 1px solid var(--node-border); padding-top: 10px;"></ul>
       </div>
    </div>
 
    <div id="galleryModal" class="modal hidden" style="z-index: 6000;">
      <div class="modal-content" style="width: 80vw; max-width: 1000px; max-height: 85vh; background: var(--node-bg); padding: 20px; border-radius: 8px; display: flex; flex-direction: column; position: relative;">
        <button class="close-btn" id="closeGalleryModal" title="Close">×</button>
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--node-border); padding-bottom: 10px; margin-bottom: 15px;">
