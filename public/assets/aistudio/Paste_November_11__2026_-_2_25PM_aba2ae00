      </div>
    </div>

    <div id="globalVideoModal" class="modal hidden" style="z-index: 5000;">
      <div class="modal-content" style="width: 600px; max-height: 80vh; background: var(--node-bg); padding: 20px; border-radius: 8px; display: flex; flex-direction: column; position: relative;">
        <button class="close-btn" id="closeGlobalVideoModal" title="Close">×</button>
