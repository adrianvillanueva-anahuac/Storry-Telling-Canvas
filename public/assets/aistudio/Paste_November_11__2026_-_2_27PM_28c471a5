                        color: '#5e6c84', 
                        label: '', 
                        arrows: 'end' 
                    }); 
                    
                    if(nodeData[startNode].containerId || nodeData[endNode].containerId) { 
                        const targetContainer = nodeData[startNode].containerId || nodeData[endNode].containerId; 
                        nodeData[startNode].containerId = targetContainer; 
