                   if (galleryMode === 'images-picker') { 
                       executeImageReplacement(img.url, false); 
                   } else if (galleryMode === 'maps-picker') { 
                       applyMapImage(img.url); 
                   } else {
                       if(selectedGalleryImages.has(img.id)) { 
                           selectedGalleryImages.delete(img.id); 
                           item.classList.remove('selected'); 
                       } else { 
                           selectedGalleryImages.add(img.id); 
