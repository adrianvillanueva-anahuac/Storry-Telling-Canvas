        } 
    });
    
    function updateTempLine(e) { 
        const startEl = document.querySelector(`#${startNode} .port-${startPort}`); 
        const cRect = canvas.getBoundingClientRect(); 
        const x1 = (startEl.getBoundingClientRect().left - cRect.left + 7) / currentZoom; 
        const y1 = (startEl.getBoundingClientRect().top - cRect.top + 7) / currentZoom; 
        const x2 = (e.clientX - cRect.left) / currentZoom; 
        const y2 = (e.clientY - cRect.top) / currentZoom; 
        
        const offsetX = Math.abs(x2 - x1) * 0.5; 
        const offsetY = Math.abs(y2 - y1) * 0.5; 
        
        let c1x = x1;
        let c1y = y1;
        let c2x = x2;
        let c2y = y2; 
        
        if (startPort === 'left') {
            c1x -= offsetX; 
        } else if (startPort === 'right') {
            c1x += offsetX; 
        } else if (startPort === 'top') {
            c1y -= offsetY; 
        } else {
            c1y += offsetY; 
        }
        
        tempLine.setAttribute('d', `M ${x1} ${y1} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${x2} ${y2}`); 
    }
    
    function buildArrowMarkers(color) { 
        const hex = color.replace('#', ''); 
        const endId = 'arrow-end-' + hex; 
        const startId = 'arrow-start-' + hex; 
        
        if(!document.getElementById(endId)) { 
            const endMarker = document.createElementNS('http://www.w3.org/2000/svg', 'marker'); 
            endMarker.setAttribute('id', endId); 
            endMarker.setAttribute('viewBox', '0 0 10 10'); 
            endMarker.setAttribute('refX', '9'); 
            endMarker.setAttribute('refY', '5'); 
            endMarker.setAttribute('markerWidth', '6'); 
            endMarker.setAttribute('markerHeight', '6'); 
            endMarker.setAttribute('orient', 'auto'); 
            
            const endPath = document.createElementNS('http://www.w3.org/2000/svg', 'path'); 
            endPath.setAttribute('d', 'M 0 0 L 10 5 L 0 10 z'); 
            endPath.setAttribute('fill', color); 
            endMarker.appendChild(endPath); 
            markerDefs.appendChild(endMarker); 
            
            const startMarker = document.createElementNS('http://www.w3.org/2000/svg', 'marker'); 
            startMarker.setAttribute('id', startId); 
            startMarker.setAttribute('viewBox', '0 0 10 10'); 
            startMarker.setAttribute('refX', '1'); 
            startMarker.setAttribute('refY', '5'); 
            startMarker.setAttribute('markerWidth', '6'); 
            startMarker.setAttribute('markerHeight', '6'); 
            startMarker.setAttribute('orient', 'auto'); 
            
            const startPath = document.createElementNS('http://www.w3.org/2000/svg', 'path'); 
            startPath.setAttribute('d', 'M 10 0 L 0 5 L 10 10 z'); 
            startPath.setAttribute('fill', color); 
            startMarker.appendChild(startPath); 
            markerDefs.appendChild(startMarker); 
        } 
        
        return { end: `url(#${endId})`, start: `url(#${startId})` }; 
    }
    
    function renderConnections() { 
        Array.from(svgLayer.children).forEach(function(child) { 
            if(child.id !== 'markerDefs') {
                child.remove(); 
            }
        }); 
        
        connections.forEach(function(c) { 
            const sNode = document.getElementById(c.source); 
            const tNode = document.getElementById(c.target); 
            if (!sNode || !tNode) return; 
            
            const sPortEl = sNode.querySelector(`.port-${c.sourcePort}`); 
            const tPortEl = tNode.querySelector(`.port-${c.targetPort}`); 
            const cRect = canvas.getBoundingClientRect(); 
            
            const x1 = (sPortEl.getBoundingClientRect().left - cRect.left + 7) / currentZoom; 
            const y1 = (sPortEl.getBoundingClientRect().top - cRect.top + 7) / currentZoom; 
            const x2 = (tPortEl.getBoundingClientRect().left - cRect.left + 7) / currentZoom; 
            const y2 = (tPortEl.getBoundingClientRect().top - cRect.top + 7) / currentZoom; 
            
            let pathData = "";
            if (c.type === 'straight') {
                pathData = `M ${x1} ${y1} L ${x2} ${y2}`;
            } else {
                const offsetX = Math.max(Math.abs(x2 - x1) * 0.5, 30); 
                const offsetY = Math.max(Math.abs(y2 - y1) * 0.5, 30); 
                let c1x = x1;
                let c1y = y1;
                let c2x = x2;
                let c2y = y2; 
                
                if (c.sourcePort === 'left') {
                    c1x -= offsetX; 
                } else if (c.sourcePort === 'right') {
                    c1x += offsetX; 
                } else if (c.sourcePort === 'top') {
                    c1y -= offsetY; 
                } else {
                    c1y += offsetY; 
                }
                
                if (c.targetPort === 'left') {
                    c2x -= offsetX; 
                } else if (c.targetPort === 'right') {
                    c2x += offsetX; 
                } else if (c.targetPort === 'top') {
                    c2y -= offsetY; 
                } else {
                    c2y += offsetY; 
                }
                
                pathData = `M ${x1} ${y1} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${x2} ${y2}`;
            }
            
            const group = document.createElementNS('http://www.w3.org/2000/svg', 'g'); 
            group.style.cursor = 'pointer'; 
            
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path'); 
            path.setAttribute('d', pathData); 
            path.setAttribute('class', 'connection-line'); 
            path.setAttribute('stroke', c.color); 
            
            if (c.style === 'dotted') {
                path.setAttribute('stroke-dasharray', '8 8'); 
            }
            
            const markers = buildArrowMarkers(c.color); 
            if (c.arrows === 'end' || c.arrows === 'both') {
                path.setAttribute('marker-end', markers.end); 
            }
            if (c.arrows === 'both') {
                path.setAttribute('marker-start', markers.start); 
            }
            
            const hitPath = document.createElementNS('http://www.w3.org/2000/svg', 'path'); 
            hitPath.setAttribute('d', pathData); 
            hitPath.setAttribute('stroke', 'rgba(0,0,0,0.01)'); 
            hitPath.setAttribute('stroke-width', '25'); 
            hitPath.setAttribute('fill', 'none'); 
            hitPath.style.pointerEvents = 'stroke'; 
            
            hitPath.addEventListener('mouseenter', function(e) { 
                if(isDragging || isDrawingLine) return; 
                activeConnectionId = c.id; 
                lineHoverBtn.style.left = `${e.clientX}px`; 
                lineHoverBtn.style.top = `${e.clientY}px`; 
                lineHoverBtn.classList.remove('hidden'); 
            }); 
            
            group.appendChild(path); 
            group.appendChild(hitPath); 
            svgLayer.appendChild(group); 
            
            if (c.label) { 
                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text'); 
                text.setAttribute('x', (x1 + x2) / 2); 
                text.setAttribute('y', (y1 + y2) / 2 - 10); 
                text.setAttribute('class', 'connection-label'); 
                text.setAttribute('text-anchor', 'middle'); 
                text.textContent = c.label; 
                svgLayer.appendChild(text); 
            } 
        }); 
    }
    
