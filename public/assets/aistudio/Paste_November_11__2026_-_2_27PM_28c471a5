                deleteDrawing(target.id);
            }
        }
    });
 
    document.addEventListener('mousemove', function(e) {
        if (isPathDrawing && e.buttons !== 1) {
            stopDrawing();
            return;
        }

        if (currentTool === 'eraser' && e.buttons === 1) { 
            if (e.target.closest('#drawingOverlay') || e.target.closest('#mapDrawingOverlay')) {
                currentOverlay.style.pointerEvents = 'none'; 
                const hitEl = document.elementFromPoint(e.clientX, e.clientY); 
                currentOverlay.style.pointerEvents = 'all'; 
                
                if (hitEl) {
                    const target = hitEl.closest('.drawing-figure');
                    if (target && target.getAttribute('data-layer') === currentActiveLayer) {
                        deleteDrawing(target.id);
                    }
                }
            }
            return;
        }

        if (currentTool === 'pencil' && isPathDrawing) {
            if (e.target.closest('#drawingOverlay') || e.target.closest('#mapDrawingOverlay')) {
                currentPathPts.push(getMouseSVGPoint(e)); 
                const pathString = currentPathPts.map(function(p) { 
                    return p.x + ' ' + p.y; 
                }).join(' L ');
                currentPathEl.setAttribute('d', `M ${pathString}`); 
            }
            return;
        }
        
        if (manipAction && activeFigure) {
            const pt = getMouseSVGPoint(e);
            const objCenterX = activeTransform.x + (activeTransform.cx || 0);
            const objCenterY = activeTransform.y + (activeTransform.cy || 0);
            const dx = pt.x - objCenterX;
            const dy = pt.y - objCenterY;

            if (manipAction === 'move') {
                wasDraggingFigure = true;
                activeTransform.x += (pt.x - startManipCoords.x);
                activeTransform.y += (pt.y - startManipCoords.y);
                startManipCoords = pt;
            } else if (manipAction === 'rotate') {
                wasDraggingFigure = true;
                activeTransform.rotate = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
            } else if (manipAction === 'scale') {
                wasDraggingFigure = true;
                const currentDist = Math.sqrt(dx * dx + dy * dy);
                const startDx = startManipCoords.x - objCenterX;
                const startDy = startManipCoords.y - objCenterY;
                const startDist = Math.sqrt(startDx * startDx + startDy * startDy);
                activeTransform.scale = Math.max(0.1, startManipScale * (currentDist / startDist));
            }
            syncManipulator();
        }
    });
 
    function stopDrawing() {
        if (activePinDrag) { 
            activePinDrag = null; 
            saveToServer(); 
        }
        if(manipAction && activeFigure) { 
            manipAction = null; 
            saveToServer(); 
        }
        if(isPathDrawing) {
            isPathDrawing = false; 
            if(currentTool === 'pencil' && currentPathEl) {
                try {
                    let d = "";
                    if (currentPathPts.length > 2) { 
                        d = `M ${currentPathPts[0].x} ${currentPathPts[0].y}`; 
                        for (let i = 1; i < currentPathPts.length - 2; i++) { 
                            const xc = (currentPathPts[i].x + currentPathPts[i + 1].x) / 2; 
                            const yc = (currentPathPts[i].y + currentPathPts[i + 1].y) / 2; 
                            d += ` Q ${currentPathPts[i].x} ${currentPathPts[i].y}, ${xc} ${yc}`; 
                        } 
                        d += ` Q ${currentPathPts[currentPathPts.length-2].x} ${currentPathPts[currentPathPts.length-2].y}, ${currentPathPts[currentPathPts.length-1].x} ${currentPathPts[currentPathPts.length-1].y}`; 
                        currentPathEl.setAttribute('d', d); 
                    } else if(currentPathPts.length > 0) { 
                        currentPathEl.setAttribute('d', `M ${currentPathPts[0].x} ${currentPathPts[0].y} L ${currentPathPts[0].x+1} ${currentPathPts[0].y+1}`); 
                    }
                    
                    const drawId = `draw-${Date.now()}`; 
                    let cx = 0;
                    let cy = 0;
                    
                    if (currentPathPts.length > 0) {
                        let minX = currentPathPts[0].x;
                        let maxX = currentPathPts[0].x;
                        let minY = currentPathPts[0].y;
                        let maxY = currentPathPts[0].y;
                        
                        for (let i = 1; i < currentPathPts.length; i++) {
                            if (currentPathPts[i].x < minX) { minX = currentPathPts[i].x; }
                            if (currentPathPts[i].x > maxX) { maxX = currentPathPts[i].x; }
                            if (currentPathPts[i].y < minY) { minY = currentPathPts[i].y; }
                            if (currentPathPts[i].y > maxY) { maxY = currentPathPts[i].y; }
                        }
                        
                        cx = (minX + maxX) / 2;
                        cy = (minY + maxY) / 2;
                    }
                    
                    const array = mapModeActive ? nodeData[activeEditNodeId].mapDrawings : nodeData[activeEditNodeId].drawings;
                    
                    array.push({ 
                        id: drawId, 
                        layer: currentActiveLayer, 
                        type: 'path', 
                        d: currentPathEl.getAttribute('d'), 
                        stroke: hexColors[currentActiveLayer], 
                        width: currentPathEl.getAttribute('stroke-width'), 
                        transform: { x: 0, y: 0, scale: 1, rotate: 0, cx: cx, cy: cy } 
                    });
                    
                    saveToServer(); 
                } catch(err) {
                    console.error("Drawing save error:", err);
                } finally {
                    currentPathPts = []; 
                    currentPathEl = null; 
                    renderDrawings(); 
                    updateLayerVisibility();
                }
            }
        }
    }
    
    document.addEventListener('mouseup', function(e) {
        if (isPathDrawing) {
            stopDrawing();
        }
        if (activePinDrag) { 
            activePinDrag = null; 
            saveToServer(); 
        }
        if (manipAction && activeFigure) { 
            manipAction = null; 
            saveToServer(); 
        }
    }, true);
    
    window.addEventListener('mouseup', function(e) {
        if (isPathDrawing) {
            stopDrawing();
        }
    }, true);
    
    document.addEventListener('mouseleave', function() { 
        if (isPathDrawing) {
            stopDrawing(); 
        }
    });
 
    function spawnFigure(shape) {
        const cx = (mapModeActive ? fullSizeMapImage : fullSizeImage).naturalWidth / 2 || 250; 
        const cy = (mapModeActive ? fullSizeMapImage : fullSizeImage).naturalHeight / 2 || 250; 
        const color = hexColors[currentActiveLayer]; 
        const drawId = `fig-${Date.now()}`; 
        const data = nodeData[activeEditNodeId]; 
        const array = mapModeActive ? data.mapDrawings : data.drawings;
        
        let pathD = "";
        if (shape === 'square') {
            pathD = "M -50 -50 L 50 -50 L 50 50 L -50 50 Z"; 
        } else if (shape === 'circle') {
            pathD = "M 0 -50 C 27 -50, 50 -27, 50 0 C 50 27, 27 50, 0 50 C -27 50, -50 27, -50 0 C -50 -27, -27 -50, 0 -50 Z"; 
        } else if (shape === 'arrow') {
            pathD = "M -30 -15 L 10 -15 L 10 -30 L 40 0 L 10 30 L 10 15 L -30 15 Z"; 
        } else if (shape === 'line-arrow') {
            pathD = "M -40 0 L 30 0 M 15 -15 L 40 0 L 15 15"; 
        } else if (shape === 'speaker') {
            pathD = "M 0 -10 L 0 10 L 15 20 L 15 -20 Z M -10 -10 L 0 -10 L 0 10 L -10 10 Z M 22 -10 Q 30 0 22 10 M 28 -20 Q 45 0 28 20"; 
        } else if (shape === 'zoom-in') {
            pathD = "M -20 -20 L -30 -30 M -30 -30 L -15 -30 M -30 -30 L -30 -15 M 20 -20 L 30 -30 M 30 -30 L 15 -30 M 30 -30 L 30 -15 M -20 20 L -30 30 M -30 30 L -15 30 M -30 30 L -30 15 M 20 20 L 30 30 M 30 30 L 15 30 M 30 30 L 30 15"; 
        } else if (shape === 'zoom-out') {
            pathD = "M -30 -30 L -20 -20 M -20 -20 L -35 -20 M -20 -20 L -20 -35 M 30 -30 L 20 -20 M 20 -20 L 35 -20 M 20 -20 L 20 -35 M -30 30 L -20 20 M -20 20 L -35 20 M -20 20 L -20 35 M 30 30 L 20 20 M 20 20 L 35 20 M 20 20 L 20 35"; 
        } else if (shape === 'hand-cube') {
            pathD = "M -15 0 L 0 -10 L 15 0 L 0 10 Z M -15 0 L -15 15 L 0 25 L 0 10 M 15 0 L 15 15 L 0 25 M 5 20 L 5 8 A 4 4 0 0 1 13 8 L 13 25 M 13 15 A 4 4 0 0 1 20 15 L 20 28 M 20 18 A 4 4 0 0 1 27 18 L 27 30 M 27 22 A 4 4 0 0 1 34 22 L 34 35 A 15 15 0 0 1 5 35 Z"; 
        } else if (shape === 'human-circle') {
            pathD = "M -25 35 A 25 8 0 1 0 25 35 A 25 8 0 1 0 -25 35 M 0 -25 A 7 7 0 1 0 0 -39 A 7 7 0 1 0 0 -25 M 0 -25 L 0 10 M -15 -10 L 15 -10 M 0 10 L -10 32 M 0 10 L 10 32";
        }
        
        const newFig = { 
            id: drawId, 
            layer: currentActiveLayer, 
            type: 'figure', 
            shape: shape, 
            d: pathD, 
            stroke: color, 
            transform: { x: cx, y: cy, scale: 1, rotate: 0, cx: 0, cy: 0 } 
        };
        
        array.push(newFig); 
        saveToServer(); 
        renderDrawings(); 
        updateLayerVisibility();
    }
 
    function renderDrawings() {
        currentDrawings.innerHTML = ''; 
        const data = nodeData[activeEditNodeId]; 
        if(!data) return;
        
        const array = mapModeActive ? data.mapDrawings : data.drawings;
        array.forEach(function(d) {
            
            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g'); 
            g.id = d.id; 
            g.setAttribute('class', 'drawing-figure'); 
            g.setAttribute('data-layer', d.layer);
            
            if (!mapModeActive && d.layer !== currentActiveLayer) {
                g.classList.add('layer-hidden');
            }
            
            const tx = d.transform && d.transform.x ? d.transform.x : 0; 
            const ty = d.transform && d.transform.y ? d.transform.y : 0; 
            const rot = d.transform && d.transform.rotate ? d.transform.rotate : 0; 
            const scl = d.transform && d.transform.scale ? d.transform.scale : 1; 
            const cx = d.transform && d.transform.cx ? d.transform.cx : 0; 
            const cy = d.transform && d.transform.cy ? d.transform.cy : 0;
            
            g.setAttribute('transform', `translate(${tx}, ${ty}) translate(${cx}, ${cy}) rotate(${rot}) scale(${scl}) translate(${-cx}, ${-cy})`);
            
            const p = document.createElementNS('http://www.w3.org/2000/svg', 'path'); 
            p.setAttribute('d', d.d); 
            p.setAttribute('stroke', d.stroke); 
            p.setAttribute('stroke-width', d.type === 'path' ? d.width : '4'); 
            p.setAttribute('fill', 'none'); 
            p.setAttribute('stroke-linecap', 'round'); 
            p.setAttribute('stroke-linejoin', 'round');
            
            if(d.type === 'path') { 
                const hitPath = document.createElementNS('http://www.w3.org/2000/svg', 'path'); 
                hitPath.setAttribute('d', d.d); 
                hitPath.setAttribute('stroke', 'transparent'); 
                hitPath.setAttribute('stroke-width', '25'); 
                hitPath.setAttribute('fill', 'none'); 
                hitPath.setAttribute('class', 'drawing-path-hit');
                g.appendChild(hitPath); 
            }
            
            g.appendChild(p); 
            currentDrawings.appendChild(g);
            
            g.addEventListener('mousedown', function(e) { 
                if(currentTool === 'none' && g.getAttribute('data-layer') === currentActiveLayer) { 
                    e.preventDefault(); 
                    activateManipulator(g, d.transform); 
                    manipAction = 'move'; 
                    startManipCoords = getMouseSVGPoint(e); 
                    wasDraggingFigure = false; 
                    e.stopPropagation(); 
                } 
            });
        });
    }
 
    function activateManipulator(figureGroup, transformData) {
        activeFigure = figureGroup; 
        activeTransform = transformData;
        
        const bbox = figureGroup.getBBox(); 
        const pad = 10; 
        const bx = bbox.x - pad; 
        const by = bbox.y - pad; 
        const bw = bbox.width + pad * 2; 
        const bh = bbox.height + pad * 2;
        
        const manipBox = currentManipGroup.querySelector('#manipBox') || currentManipGroup.querySelector('#mapManipBox'); 
        manipBox.setAttribute('x', bx); 
        manipBox.setAttribute('y', by); 
        manipBox.setAttribute('width', bw); 
        manipBox.setAttribute('height', bh);
        
        const manipLine = currentManipGroup.querySelector('#manipLine') || currentManipGroup.querySelector('#mapManipLine'); 
        manipLine.setAttribute('x1', bx + bw / 2); 
        manipLine.setAttribute('y1', by); 
        manipLine.setAttribute('x2', bx + bw / 2); 
        manipLine.setAttribute('y2', by - 30);
        
        const manipRotate = currentManipGroup.querySelector('#manipRotate') || currentManipGroup.querySelector('#mapManipRotate'); 
        manipRotate.setAttribute('cx', bx + bw / 2); 
        manipRotate.setAttribute('cy', by - 30);
        
        const manipScale = currentManipGroup.querySelector('#manipScale') || currentManipGroup.querySelector('#mapManipScale'); 
        manipScale.setAttribute('x', bx + bw - 8); 
        manipScale.setAttribute('y', by + bh - 8);
        
        currentManipGroup.classList.remove('hidden'); 
        syncManipulator();
    }
    
    function deactivateManipulator() { 
        activeFigure = null; 
        activeTransform = null; 
        currentManipGroup.classList.add('hidden'); 
    }
    
    function syncManipulator() {
        if(!activeFigure) return;
        
        const cx = activeTransform.cx || 0; 
        const cy = activeTransform.cy || 0;
        const transformStr = `translate(${activeTransform.x}, ${activeTransform.y}) translate(${cx}, ${cy}) rotate(${activeTransform.rotate}) scale(${activeTransform.scale}) translate(${-cx}, ${-cy})`;
        
        currentManipGroup.setAttribute('transform', transformStr); 
        activeFigure.setAttribute('transform', transformStr);
        
        const invScale = 1 / activeTransform.scale;
        
        const manipLine = currentManipGroup.querySelector('#manipLine') || currentManipGroup.querySelector('#mapManipLine'); 
        manipLine.setAttribute('stroke-width', 2 * invScale); 
        
        const manipBox = currentManipGroup.querySelector('#manipBox') || currentManipGroup.querySelector('#mapManipBox'); 
        manipBox.setAttribute('stroke-width', 2 * invScale); 
        
        const manipRotate = currentManipGroup.querySelector('#manipRotate') || currentManipGroup.querySelector('#mapManipRotate'); 
        manipRotate.setAttribute('r', 8 * invScale); 
        manipRotate.setAttribute('stroke-width', 2 * invScale);
        
        const manipScale = currentManipGroup.querySelector('#manipScale') || currentManipGroup.querySelector('#mapManipScale'); 
        manipScale.setAttribute('width', 16 * invScale); 
        manipScale.setAttribute('height', 16 * invScale);
        
        const bbox = activeFigure.getBBox(); 
        const bx = bbox.x - 10; 
        const by = bbox.y - 10; 
        const bw = bbox.width + 20; 
        const bh = bbox.height + 20;
        
        manipScale.setAttribute('x', bx + bw - (8 * invScale)); 
        manipScale.setAttribute('y', by + bh - (8 * invScale));
    }
 
    document.body.addEventListener('mousedown', function(e) {
        if(e.target.closest('#manipulatorGroup') || e.target.closest('#mapManipulatorGroup')) {
            if(!activeFigure) return; 
            e.preventDefault(); 
            e.stopPropagation(); 
            startManipCoords = getMouseSVGPoint(e);
            
            if(e.target.id.includes('manipRotate')) { 
                manipAction = 'rotate'; 
                startManipAngle = activeTransform.rotate; 
            } 
            else if(e.target.id.includes('manipScale')) { 
                manipAction = 'scale'; 
                startManipScale = activeTransform.scale; 
            } 
            else { 
                manipAction = 'move'; 
            }
        }
    });
    
    document.addEventListener('mousemove', function(e) {
        if(!manipAction || !activeFigure) return; 
        
        const pt = getMouseSVGPoint(e);
        const objCenterX = activeTransform.x + (activeTransform.cx || 0); 
        const objCenterY = activeTransform.y + (activeTransform.cy || 0);
        const dx = pt.x - objCenterX; 
        const dy = pt.y - objCenterY;
        
        if (manipAction === 'move') { 
            wasDraggingFigure = true; 
            activeTransform.x += (pt.x - startManipCoords.x); 
            activeTransform.y += (pt.y - startManipCoords.y); 
            startManipCoords = pt; 
        } 
        else if (manipAction === 'rotate') { 
            wasDraggingFigure = true; 
            activeTransform.rotate = Math.atan2(dy, dx) * (180 / Math.PI) + 90; 
        } 
        else if (manipAction === 'scale') { 
            wasDraggingFigure = true; 
            const currentDist = Math.sqrt(dx*dx + dy*dy); 
            const startDx = startManipCoords.x - objCenterX; 
            const startDy = startManipCoords.y - objCenterY; 
            const startDist = Math.sqrt(startDx*startDx + startDy*startDy); 
            activeTransform.scale = Math.max(0.1, startManipScale * (currentDist / startDist)); 
        }
        
        syncManipulator();
    });
    
  });
</script>