            updateTempLine(e); 
        }
    });
    
    document.addEventListener('mouseup', function(e) { 
        if (isDrawingLine) { 
            isDrawingLine = false; 
            tempLine.style.display = 'none'; 
            
            if (e.target.classList.contains('port')) { 
                const endNode = e.target.closest('.workflow-node').id; 
                const endPort = e.target.dataset.port; 
                
                if (startNode !== endNode) { 
                    connectionIdCounter++; 
                    connections.push({ 
                        id: 'conn-' + connectionIdCounter, 
