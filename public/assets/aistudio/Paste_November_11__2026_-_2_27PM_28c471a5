<script>
  window.onerror = function(message) { 
      console.error("Script Error: ", message); 
  };

  let ytPlayer = null;
  let activeVideoColumn = null; 
  let pendingVideoGlobalId = null;
  
  function onYouTubeIframeAPIReady() { 
      console.log("YT API Ready"); 
  }
  
  function onPlayerStateChange(event) {
      const snapBtn = document.getElementById('takeSnapshotBtn');
      if (event.data === YT.PlayerState.PAUSED || event.data === YT.PlayerState.ENDED) {
          snapBtn.disabled = false;
          snapBtn.style.opacity = '1';
          snapBtn.innerText = "📸 Add Mark (Ready)";
      } else {
          snapBtn.disabled = true;
          snapBtn.style.opacity = '0.5';
          snapBtn.innerText = "Timestamp (Pause to Mark)";
      }
  }

  function extractVideoID(url) {
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length == 11) ? match[2] : null;
  }
 
  document.addEventListener('DOMContentLoaded', function() {
    
    // DOM ELEMENTS
    const viewport = document.getElementById('canvasViewport');
    const canvas = document.getElementById('nodeCanvas');
    const svgLayer = document.getElementById('connectionLayer');
    const markerDefs = document.getElementById('markerDefs');
    
    const editModal = document.getElementById('nodeEditModal');
    const dashThumbImage = document.getElementById('dashThumbImage');
    const dashThumbDrop = document.getElementById('dashThumbDrop');
    
    const pinningModal = document.getElementById('pinningModal');
    const fullSizeImage = document.getElementById('fullSizeImage');
    const imageWrapper = document.getElementById('imageWrapper');
    
    const mapViewerModal = document.getElementById('mapViewerModal');
    const fullSizeMapImage = document.getElementById('fullSizeMapImage');
    const mapImageWrapper = document.getElementById('mapImageWrapper');
    
    let currentOverlay = document.getElementById('drawingOverlay');
    let currentDrawings = document.getElementById('drawingCanvas');
    let currentManipGroup = document.getElementById('manipulatorGroup');
    
    const commentList = document.getElementById('commentList');
    const pinPopup = document.getElementById('pinCreationPopup');
    
    const lineHoverBtn = document.getElementById('lineEditHoverBtn');
    const linePropsMenu = document.getElementById('linePropertiesMenu');
    const textPropsMenu = document.getElementById('textPropertiesMenu');
    const labelManagerModal = document.getElementById('labelManagerModal');
    const addTextModal = document.getElementById('addTextModal');
    const deleteWarnModal = document.getElementById('deleteWarningModal');
    const storedNodesModal = document.getElementById('storedNodesModal');
 
    const galleryModal = document.getElementById('galleryModal');
    const galleryGrid = document.getElementById('galleryGrid');
    const galleryLoading = document.getElementById('galleryLoading');
    
    const globalVideoModal = document.getElementById('globalVideoModal');
    const videoSelectionModal = document.getElementById('videoSelectionModal');
    const videoPlayerModal = document.getElementById('videoPlayerModal');
 
    // DATABASES & STATE
    let nodeData = {}; 
    let connections = []; 
    let textData = {}; 
    let labelData = {}; 
    let storedNodesData = {};
    let globalVideos = [];
    
    let nodeCounter = 0; 
    let connectionIdCounter = 0; 
    let textCounter = 0;
    
    let activeEditNodeId = null; 
    let activeConnectionId = null; 
    let activeTextId = null; 
    let pendingDeleteNodeId = null;
    let isDashboardReadOnly = false; 
    let pendingPinCoords = null;
    let currentZoom = 1; 
    
    let currentUserName = "Anonymous";
    let currentUserRole = "Editor";
    
    let pendingImageReplaceUrl = null;
    let galleryMode = 'images-manage'; 
    let selectedGalleryImages = new Set();
    
    let currentActiveLayer = 'enfoque'; 
    let currentTool = 'none'; 
    let currentShape = 'square';
    let mapModeActive = false; 
    const hexColors = { 
        enfoque: '#0052cc', 
        accion: '#ff5630', 
        descripcion: '#36b37e', 
        map: '#ffc400' 
    };

    // --- LOGIN SEQUENCE ---
    document.getElementById('loginBtn').addEventListener('click', function() {
        const user = document.getElementById('loginUsername').value.trim();
        const pin = document.getElementById('loginPin').value.trim();
        const errDiv = document.getElementById('loginError');

        if (!user || !pin) {
            errDiv.innerText = "Please enter both Username and PIN.";
            return;
        }

        errDiv.innerText = "Verifying credentials...";
        document.getElementById('loginBtn').disabled = true;

        google.script.run.withSuccessHandler(function(res) {
            document.getElementById('loginBtn').disabled = false;
            
            if (res.error) {
                errDiv.innerText = res.error;
            } else if (res.success) {
                document.getElementById('loginModal').classList.add('hidden');
                
                currentUserName = res.name;
                currentUserRole = res.role;
                document.getElementById('popupAuthor').innerText = "by " + currentUserName;
                
                if (currentUserRole === 'Viewer') {
                    document.getElementById('addNodeBtn').style.display = 'none';
                }

                google.script.run.withSuccessHandler(function(savedState) {
                  if (savedState && !savedState.error) {
                    nodeData = savedState.nodes || {}; 
                    connections = savedState.connections || []; 
                    textData = savedState.texts || {}; 
                    labelData = savedState.labels || {}; 
                    storedNodesData = savedState.storedNodes || {};
                    globalVideos = savedState.globalVideos || [];
                    
                    Object.keys(nodeData).forEach(function(id) { 
                        if (!nodeData[id].drawings) nodeData[id].drawings = []; 
                        if (!nodeData[id].mapDrawings) nodeData[id].mapDrawings = []; 
                        if (!nodeData[id].mapImage) nodeData[id].mapImage = null; 
                        if (!nodeData[id].mapName) nodeData[id].mapName = ''; 
                        
                        if (!nodeData[id].videos || Array.isArray(nodeData[id].videos)) {
                            nodeData[id].videos = { enfoque: null, accion: null, descripcion: null }; 
                        }
                    });
                    
                    const nIds = Object.keys(nodeData).map(function(id) { 
                        return parseInt(id.split('-')[1]); 
                    });
                    nodeCounter = nIds.length > 0 ? Math.max.apply(null, nIds) : 0;
                    
                    const cIds = connections.map(function(c) { 
                        return parseInt(c.id.split('-')[1]); 
                    }); 
                    connectionIdCounter = cIds.length > 0 ? Math.max.apply(null, cIds) : 0;
                    
                    const tIds = Object.keys(textData).map(function(id) { 
                        return parseInt(id.split('-')[1]); 
                    });
                    textCounter = tIds.length > 0 ? Math.max.apply(null, tIds) : 0;
             
                    Object.keys(nodeData).forEach(function(id) { 
                        rebuildNodeDOM(id, nodeData[id]); 
                    });
                    Object.keys(textData).forEach(function(id) { 
                        rebuildTextDOM(id, textData[id]); 
                    });
                    
                    updateStoredNodesCount();
                    renderConnections(); 
                    centerCanvas(); 
                  }
                }).loadAppState();
            }
        }).verifyUser(user, pin);
    });

 
    function saveToServer() {
      if (currentUserRole === 'Viewer') return; 
        
      document.querySelectorAll('.workflow-node').forEach(function(n) {
        if (nodeData[n.id]) { 
            nodeData[n.id].x = n.style.left; 
            nodeData[n.id].y = n.style.top; 
        }
      });
      document.querySelectorAll('.canvas-text-node').forEach(function(t) {
        if (textData[t.id]) { 
            textData[t.id].x = t.style.left; 
            textData[t.id].y = t.style.top; 
        }
      });
      google.script.run.saveAppState({ 
          nodes: nodeData, 
          connections: connections, 
          texts: textData, 
          labels: labelData, 
          storedNodes: storedNodesData, 
          globalVideos: globalVideos 
      });
    }
 
    function updateZoomUI() {
      const zoomPercent = Math.round(currentZoom * 100);
      const currentZoomOpt = document.getElementById('currentZoomOption');
      if (currentZoomOpt) { 
          currentZoomOpt.innerText = zoomPercent + '% Zoom'; 
      }
      document.getElementById('viewControlSelect').value = 'custom';
    }
 
    viewport.addEventListener('wheel', function(e) {
      if (e.ctrlKey || e.metaKey || document.querySelector('.modal:not(.hidden)')) return; 
      
      e.preventDefault();
      const rect = viewport.getBoundingClientRect(); 
      const mouseX = e.clientX - rect.left; 
      const mouseY = e.clientY - rect.top;
      
      const canvasX = (viewport.scrollLeft + mouseX) / currentZoom; 
      const canvasY = (viewport.scrollTop + mouseY) / currentZoom;
      
      let newZoom = currentZoom + (e.deltaY < 0 ? 0.05 : -0.05); 
      newZoom = Math.max(0.2, Math.min(newZoom, 3)); 
      currentZoom = newZoom; 
      
      canvas.style.transform = `scale(${currentZoom})`;
      
      updateZoomUI();
      viewport.scrollLeft = (canvasX * currentZoom) - mouseX; 
      viewport.scrollTop = (canvasY * currentZoom) - mouseY;
      lineHoverBtn.classList.add('hidden');
    }, {passive: false});
 
    document.getElementById('viewControlSelect').addEventListener('change', function(e) {
      if (e.target.value === "100") { 
          currentZoom = 1; 
          canvas.style.transform = `scale(1)`; 
          updateZoomUI(); 
      }
      if (e.target.value === "center") {
          centerCanvas();
      }
      if (e.target.value === "fit") {
          fitAllNodes();
      }
      document.getElementById('viewControlSelect').value = 'custom';
    });
 
    function centerCanvas() { 
        currentZoom = 1; 
        canvas.style.transform = `scale(1)`; 
        viewport.scrollLeft = 2500 - (viewport.clientWidth / 2); 
        viewport.scrollTop = 2500 - (viewport.clientHeight / 2); 
        updateZoomUI();
    }
    
    function fitAllNodes() { 
        const nodes = document.querySelectorAll('.workflow-node, .canvas-text-node');
        if (nodes.length === 0) { 
            centerCanvas(); 
            return; 
        }
        
        let minX = Infinity;
        let minY = Infinity;
        let maxX = -Infinity;
        let maxY = -Infinity;
        
        nodes.forEach(function(el) {
            const x = parseFloat(el.style.left) || 0; 
            const y = parseFloat(el.style.top) || 0;
            const w = el.offsetWidth || 220; 
            const h = el.offsetHeight || 150;
            
            if (x < minX) minX = x; 
            if (y < minY) minY = y; 
            if (x + w > maxX) maxX = x + w; 
            if (y + h > maxY) maxY = y + h;
        });
        
        const padding = 100; 
        minX -= padding; 
        minY -= padding; 
        maxX += padding; 
        maxY += padding;
        
        const contentWidth = maxX - minX; 
        const contentHeight = maxY - minY;
        const viewWidth = viewport.clientWidth; 
        const viewHeight = viewport.clientHeight;
        
        const scaleX = viewWidth / contentWidth; 
        const scaleY = viewHeight / contentHeight;
        
        let newZoom = Math.min(scaleX, scaleY);
        newZoom = Math.max(0.2, Math.min(newZoom, 3)); 
        currentZoom = newZoom;
        
        canvas.style.transform = `scale(${currentZoom})`;
        
        const boxCenterX = minX + (contentWidth / 2); 
        const boxCenterY = minY + (contentHeight / 2);
        
        viewport.scrollLeft = (boxCenterX * currentZoom) - (viewWidth / 2); 
        viewport.scrollTop = (boxCenterY * currentZoom) - (viewHeight / 2);
        updateZoomUI();
    }
 
    document.getElementById('toggleDarkMode').addEventListener('click', function(e) { 
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark'; 
        document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark'); 
        e.target.innerText = isDark ? '🌙' : '☀️'; 
    });
 
    let isPanning = false; 
    let startX, startY, scrollLeft, scrollTop;
    
    viewport.addEventListener('mousedown', function(e) {
      if (e.target.closest('.workflow-node') || 
          e.target.closest('.canvas-text-node') || 
          e.target.closest('.floating-menu') || 
          e.target.closest('.modal') || 
          e.target.id === 'lineEditHoverBtn') {
          return;
      }
      
      isPanning = true; 
      viewport.style.cursor = 'grabbing';
      
      startX = e.pageX - viewport.offsetLeft; 
      startY = e.pageY - viewport.offsetTop;
      scrollLeft = viewport.scrollLeft; 
      scrollTop = viewport.scrollTop;
      
      lineHoverBtn.classList.add('hidden'); 
      linePropsMenu.classList.add('hidden'); 
      textPropsMenu.classList.add('hidden');
    });
    
    viewport.addEventListener('mouseup', function() { 
        isPanning = false; 
        viewport.style.cursor = 'default'; 
    });
    
    viewport.addEventListener('mousemove', function(e) {
      if (!isPanning) return; 
      viewport.scrollLeft = scrollLeft - ((e.pageX - viewport.offsetLeft) - startX) * 1.5; 
      viewport.scrollTop = scrollTop - ((e.pageY - viewport.offsetTop) - startY) * 1.5;
    });
 
    function getConnectedNodes(startNodeId) {
      let visited = new Set(); 
      let stack = [startNodeId];
      
      while(stack.length > 0) {
        let curr = stack.pop();
        if(!visited.has(curr)) {
            visited.add(curr); 
            connections.forEach(function(c) { 
                if(c.source === curr && !visited.has(c.target)) {
                    stack.push(c.target);
                }
                if(c.target === curr && !visited.has(c.source)) {
                    stack.push(c.source); 
                }
            }); 
        }
      } 
      return Array.from(visited);
    }
 
    function checkContainerDrop(elementId, type) {
      const isNode = type === 'node'; 
      const elData = isNode ? nodeData[elementId] : textData[elementId]; 
      const elDOM = document.getElementById(elementId);
      if(!elDOM) return;
 
      const nx = parseFloat(elData.x) + (elDOM.offsetWidth / 2); 
      const ny = parseFloat(elData.y) + (elDOM.offsetHeight / 2);
      let droppedInto = null;
 
      Object.keys(textData).forEach(function(tid) {
        if(textData[tid].mode === 'container' && tid !== elementId) {
            const tx = parseFloat(textData[tid].x); 
            const ty = parseFloat(textData[tid].y); 
            const tw = textData[tid].width || 300; 
            const th = textData[tid].height || 200;
            
            if(nx >= tx && nx <= tx+tw && ny >= ty && ny <= ty+th) {
                droppedInto = tid;
            }
        }
      });
 
      if (droppedInto && !isNode && textData[elementId].mode === 'container') {
          let currentParent = textData[droppedInto].containerId; 
          let isCircular = false;
          while(currentParent) { 
              if (currentParent === elementId) { 
                  isCircular = true; 
                  break; 
              } 
              currentParent = textData[currentParent].containerId; 
          }
          if(isCircular) {
              droppedInto = null;
          }
      }
 
      if(droppedInto) { 
          elData.containerId = droppedInto; 
          if (isNode) { 
              const connected = getConnectedNodes(elementId); 
              connected.forEach(function(id) { 
                  if(nodeData[id]) {
                      nodeData[id].containerId = droppedInto; 
                  }
              }); 
          }
      } else { 
          elData.containerId = null; 
          if (isNode) { 
              const connected = getConnectedNodes(elementId); 
              connected.forEach(function(id) { 
                  if(nodeData[id]) {
                      nodeData[id].containerId = null; 
                  }
              }); 
          } 
      }
      
      updateContainerBounds(); 
      updateContainerBounds();
    }
 
    function updateContainerBounds() {
      Object.keys(textData).forEach(function(tid) {
        if(textData[tid].mode === 'container') {
          let minX = Infinity;
          let minY = Infinity;
          let maxX = -Infinity;
          let maxY = -Infinity; 
          let hasNodes = false;
          
          Object.keys(nodeData).forEach(function(nid) { 
              if(nodeData[nid].containerId === tid) { 
                  hasNodes = true; 
                  let nx = parseFloat(nodeData[nid].x); 
                  let ny = parseFloat(nodeData[nid].y); 
                  let nDOM = document.getElementById(nid); 
                  let nw = nDOM ? nDOM.offsetWidth : 220; 
                  let nh = nDOM ? nDOM.offsetHeight : 150;
                  
                  if(nx < minX) minX = nx; 
                  if(ny < minY) minY = ny; 
                  if(nx + nw > maxX) maxX = nx + nw; 
                  if(ny + nh > maxY) maxY = ny + nh; 
              } 
          });
          
          Object.keys(textData).forEach(function(childTid) {
              if(textData[childTid].containerId === tid && childTid !== tid) {
                  hasNodes = true; 
                  let cx = parseFloat(textData[childTid].x); 
                  let cy = parseFloat(textData[childTid].y); 
                  let cDOM = document.getElementById(childTid); 
                  let cw = cDOM ? cDOM.offsetWidth : 100; 
                  let ch = cDOM ? cDOM.offsetHeight : 50;
                  
                  if(cx < minX) minX = cx; 
                  if(cy < minY) minY = cy; 
                  if(cx + cw > maxX) maxX = cx + cw; 
                  if(cy + ch > maxY) maxY = cy + ch;
              }
          });
          
          if(hasNodes) { 
              textData[tid].x = (minX - 30) + 'px'; 
              textData[tid].y = (minY - 50) + 'px'; 
              textData[tid].width = (maxX - minX + 60); 
              textData[tid].height = (maxY - minY + 80); 
          } else { 
              textData[tid].width = Math.max(textData[tid].width || 300, 300); 
              textData[tid].height = Math.max(textData[tid].height || 200, 200); 
          }
          
          const tEl = document.getElementById(tid); 
          if(tEl) { 
              tEl.style.left = textData[tid].x; 
              tEl.style.top = textData[tid].y; 
              tEl.style.width = textData[tid].width + 'px'; 
              tEl.style.height = textData[tid].height + 'px'; 
          }
        }
      }); 
      
      renderConnections();
    }
 
    let activeDragElement = null; 
    let isDragging = false; 
    let dragStartX, dragStartY; 
    let wasDragged = false; 
    let dragChildrenOffsets = []; 
    let activeElementStartX = 0; 
    let activeElementStartY = 0;
    
    canvas.addEventListener('click', function(e) {
      if (currentUserRole === 'Viewer') return;
      
      const editBtn = e.target.closest('.edit-node-btn'); 
      if (editBtn) {
          openDashboardModal(editBtn.closest('.workflow-node').id, false);
      }
      
      const textSetBtn = e.target.closest('.text-settings-btn'); 
      if (textSetBtn) {
          openTextMenu(e, textSetBtn.closest('.canvas-text-node').id);
      }
      
      const deleteNodeBtn = e.target.closest('.delete-node-btn'); 
      if (deleteNodeBtn) { 
          pendingDeleteNodeId = deleteNodeBtn.closest('.workflow-node').id; 
          deleteWarnModal.classList.remove('hidden'); 
      }
    });
 
    canvas.addEventListener('mousedown', function(e) {
      if (currentUserRole === 'Viewer') return;
      
      if (e.target.classList.contains('port') || 
          e.target.closest('.node-action-bar') || 
          e.target.closest('.text-settings-btn') || 
          e.target.classList.contains('delete-text-btn') || 
          e.target.classList.contains('unlink-text-btn') || 
          document.activeElement.isContentEditable || 
          e.target.isContentEditable) {
          return;
      }
      
      const node = e.target.closest('.workflow-node'); 
      const textNode = e.target.closest('.canvas-text-node'); 
      const targetElement = node || textNode; 
      
      if (!targetElement) return;
      
      isDragging = true; 
      activeDragElement = targetElement; 
      wasDragged = false;
      
      const canvasRect = canvas.getBoundingClientRect(); 
      activeElementStartX = parseFloat(activeDragElement.style.left || 0); 
      activeElementStartY = parseFloat(activeDragElement.style.top || 0);
      
      dragStartX = (e.clientX - canvasRect.left) / currentZoom - activeElementStartX; 
      dragStartY = (e.clientY - canvasRect.top) / currentZoom - activeElementStartY;
      
      dragChildrenOffsets = [];
      
      if(textNode && textData[textNode.id].mode === 'container') { 
          function getDescendants(parentId) {
              let desc = [];
              Object.keys(nodeData).forEach(function(nid) { 
                  if(nodeData[nid].containerId === parentId) { 
                      desc.push({ 
                          id: nid, 
                          type: 'node', 
                          startX: parseFloat(nodeData[nid].x), 
                          startY: parseFloat(nodeData[nid].y) 
                      }); 
                  } 
              });
              Object.keys(textData).forEach(function(tid) { 
                  if(textData[tid].containerId === parentId && tid !== parentId) { 
                      desc.push({ 
                          id: tid, 
                          type: 'text', 
                          startX: parseFloat(textData[tid].x), 
                          startY: parseFloat(textData[tid].y) 
                      }); 
                      if (textData[tid].mode === 'container') { 
                          desc = desc.concat(getDescendants(tid)); 
                      } 
                  } 
              }); 
              return desc;
          }
          dragChildrenOffsets = getDescendants(textNode.id);
      }
      
      activeDragElement.style.zIndex = 100; 
      lineHoverBtn.classList.add('hidden');
    });
 
    document.addEventListener('mousemove', function(e) {
      if (!isDragging || !activeDragElement) return;
      
      wasDragged = true; 
      const canvasRect = canvas.getBoundingClientRect();
      const newX = (e.clientX - canvasRect.left) / currentZoom - dragStartX; 
      const newY = (e.clientY - canvasRect.top) / currentZoom - dragStartY;
      const deltaX = newX - activeElementStartX; 
      const deltaY = newY - activeElementStartY;
 
      activeDragElement.style.left = `${newX}px`; 
      activeDragElement.style.top = `${newY}px`;
      
      const isNode = activeDragElement.classList.contains('workflow-node');
      if (isNode) { 
          nodeData[activeDragElement.id].x = `${newX}px`; 
          nodeData[activeDragElement.id].y = `${newY}px`; 
      } else { 
          textData[activeDragElement.id].x = `${newX}px`; 
          textData[activeDragElement.id].y = `${newY}px`; 
      }
      
      if(dragChildrenOffsets.length > 0) { 
         dragChildrenOffsets.forEach(function(child) { 
             const childEl = document.getElementById(child.id); 
             if(childEl) { 
                 childEl.style.left = `${child.startX + deltaX}px`; 
                 childEl.style.top = `${child.startY + deltaY}px`;
                 if(child.type === 'node') { 
                     nodeData[child.id].x = childEl.style.left; 
                     nodeData[child.id].y = childEl.style.top; 
                 } else { 
                     textData[child.id].x = childEl.style.left; 
                     textData[child.id].y = childEl.style.top; 
                 } 
             }
         }); 
      }
      
      renderConnections(); 
 
      let hoveredContainer = null; 
      const mx = newX + (activeDragElement.offsetWidth / 2); 
      const my = newY + (activeDragElement.offsetHeight / 2);
      
      Object.keys(textData).forEach(function(tid) {
        if(textData[tid].mode === 'container' && tid !== activeDragElement.id) {
           const tx = parseFloat(textData[tid].x); 
           const ty = parseFloat(textData[tid].y); 
           const tw = textData[tid].width || 300; 
           const th = textData[tid].height || 200;
           if(mx >= tx && mx <= tx+tw && my >= ty && my <= ty+th) {
               hoveredContainer = tid;
           }
        }
      });
      
      document.querySelectorAll('.text-mode-container').forEach(function(c) { 
          c.classList.remove('container-hover'); 
      });
      
      if (hoveredContainer) { 
          document.getElementById(hoveredContainer).classList.add('container-hover'); 
          document.body.style.cursor = 'copy'; 
      } else { 
          document.body.style.cursor = 'grabbing'; 
      }
    });
 
    document.addEventListener('mouseup', function() {
      if (activeDragElement) {
        activeDragElement.style.zIndex = ''; 
        document.body.style.cursor = 'default'; 
        
        document.querySelectorAll('.text-mode-container').forEach(function(c) { 
            c.classList.remove('container-hover'); 
        });
        
        if(isDragging && wasDragged) { 
            const isNode = activeDragElement.classList.contains('workflow-node'); 
            checkContainerDrop(activeDragElement.id, isNode ? 'node' : 'text'); 
            saveToServer(); 
        }
      }
      isDragging = false; 
      activeDragElement = null; 
      dragChildrenOffsets = [];
    });
 
    document.getElementById('addNodeBtn').addEventListener('click', function() {
      nodeCounter++; 
      const nodeId = 'node-' + nodeCounter;
      const spawnX = (viewport.scrollLeft + (viewport.clientWidth / 2)) / currentZoom - 100; 
