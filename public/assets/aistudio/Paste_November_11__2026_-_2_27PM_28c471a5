    function processImageFile(file, isMap = false) { 
        if (!file) return; 
        
        const reader = new FileReader(); 
        const targetDrop = isMap ? document.getElementById('sideMapDrop') : document.getElementById('dashThumbDrop');
        const dropZoneText = targetDrop.querySelector('span'); 
        
        if(dropZoneText) {
            dropZoneText.innerText = "Uploading..."; 
        }
        
        const folderType = isMap ? 'maps' : 'images';
        
        reader.onload = function(event) { 
            const base64Data = event.target.result; 
            const filename = `Node_${activeEditNodeId}_${Date.now()}.png`; 
            
            google.script.run.withSuccessHandler(function(res) { 
                if(res.error) { 
                    console.error("Upload Error"); 
                    return; 
                } 
                
                if(dropZoneText) {
                    dropZoneText.innerText = isMap ? "Paste Map Here" : "Paste Image Here"; 
                }
                
                if (isMap) { 
                    applyMapImage(res.url); 
                } else { 
                    initiateImageApplication(res.url); 
                }
            }).uploadImageToDrive(base64Data, filename, folderType); 
        }; 
        reader.readAsDataURL(file); 
    }
    
