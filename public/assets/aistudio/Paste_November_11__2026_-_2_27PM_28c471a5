    function getMouseSVGPoint(e) { 
        const pt = currentOverlay.createSVGPoint(); 
        pt.x = e.clientX; 
        pt.y = e.clientY; 
        const ctm = currentOverlay.getScreenCTM(); 
        if(!ctm) {
            return { x: e.offsetX, y: e.offsetY }; 
        }
        return pt.matrixTransform(ctm.inverse()); 
    }
    
    function deleteDrawing(id) {
        const data = nodeData[activeEditNodeId];
        if (mapModeActive) {
            data.mapDrawings = data.mapDrawings.filter(function(d) { 
                return d.id !== id; 
            });
        } else {
            data.drawings = data.drawings.filter(function(d) { 
                return d.id !== id; 
            });
        }
        
        const el = document.getElementById(id);
        if (el) {
            el.remove();
        }
        
        saveToServer();
        if (activeFigure && activeFigure.id === id) {
            deactivateManipulator();
        }
    }
 
    document.addEventListener('mousedown', function(e) {
        if (currentTool === 'eraser') {
            const target = e.target.closest('.drawing-figure');
            if (target && target.getAttribute('data-layer') === currentActiveLayer) {
                deleteDrawing(target.id);
            }
            return; 
        }
        
        if (e.target.closest('#manipulatorGroup') || e.target.closest('#mapManipulatorGroup')) {
            if (!activeFigure) return;
            e.preventDefault();
            e.stopPropagation();
            startManipCoords = getMouseSVGPoint(e);
            
            if (e.target.id.includes('manipRotate')) {
                manipAction = 'rotate';
                startManipAngle = activeTransform.rotate;
            } else if (e.target.id.includes('manipScale')) {
                manipAction = 'scale';
                startManipScale = activeTransform.scale;
            } else {
                manipAction = 'move';
            }
            return;
        }

        if(e.target.id === 'drawingCatch' || e.target.id === 'mapDrawingCatch') {
            if(currentTool === 'none') { 
                deactivateManipulator(); 
                return; 
            }
            if(currentTool === 'pencil') { 
                isPathDrawing = true; 
                currentPathPts = [getMouseSVGPoint(e)]; 
                deactivateManipulator(); 
                
                const strokeW = document.getElementById('pencilThickness').value; 
                currentPathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path'); 
                currentPathEl.setAttribute('class', 'drawing-path'); 
                currentPathEl.setAttribute('stroke', hexColors[currentActiveLayer]); 
                currentPathEl.setAttribute('stroke-width', strokeW); 
                currentPathEl.setAttribute('data-layer', currentActiveLayer); 
                currentDrawings.appendChild(currentPathEl); 
            }
        }
    });

    document.addEventListener('mouseover', function(e) {
        if (currentTool === 'eraser' && e.buttons === 1) { 
