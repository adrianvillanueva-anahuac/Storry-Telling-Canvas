                    <img src="https://img.youtube.com/vi/${gv.id}/default.jpg" style="width: 60px; height: 34px; object-fit:cover; border-radius: 4px; cursor: pointer;" onclick="if(ytPlayer) ytPlayer.seekTo(${snap.time}, true);">
