    const tempLine = document.getElementById('tempLine'); 
    let isDrawingLine = false; 
    let startPort = null; 
    let startNode = null;
    
    canvas.addEventListener('mousedown', function(e) { 
        if (e.target.classList.contains('port')) { 
            isDrawingLine = true; 
