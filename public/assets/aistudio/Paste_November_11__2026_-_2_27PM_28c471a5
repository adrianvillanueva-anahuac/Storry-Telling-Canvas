    function processGalleryUploads(files) {
        if (!files || files.length === 0) return;
        const statusText = document.getElementById('galleryUploadStatus'); 
        let currentIndex = 0;
        const folderType = galleryMode.includes('maps') ? 'maps' : 'images';
        
        function uploadNext() {
            if (currentIndex >= files.length) { 
                statusText.innerText = "Drop files here or Click to upload to Drive"; 
                refreshGallery(); 
                document.getElementById('galleryUploadInput').value = ''; 
                return; 
            }
            statusText.innerText = `Uploading image ${currentIndex + 1} of ${files.length}...`;
            const file = files[currentIndex]; 
            const reader = new FileReader();
            
            reader.onload = function(event) {
                const base64Data = event.target.result; 
                const filename = `GalleryImg_${Date.now()}_${currentIndex}.png`;
                google.script.run.withSuccessHandler(function(res) { 
                    currentIndex++; 
                    uploadNext(); 
                }).uploadImageToDrive(base64Data, filename, folderType);
            }; 
            reader.readAsDataURL(file);
        } 
        uploadNext();
    }
    
